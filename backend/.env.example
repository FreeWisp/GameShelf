# ---- GameShelf backend configuration ----
PORT=4000
JWT_SECRET=change-me-in-production

# Steam Web API (https://developer.valvesoftware.com/wiki/Steam_Web_API)
STEAM_API_KEY=0627880C8E24EAD513C13AF45DA1E048

# IGDB / Twitch credentials (https://api-docs.igdb.com/#getting-started)
# Create a Twitch app -> Client ID + Client Secret. If left empty the backend
# falls back to the bundled offline seed dataset so the app still works.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Queue-based Load Leveling tuning
QUEUE_CONCURRENCY=2
QUEUE_MIN_INTERVAL_MS=250

# Epic free-games push: scheduler runs automatically every 6h (no config needed).
# Steam "Sign in through Steam" (OpenID 2.0) needs no extra config: realm/return
# URLs are derived from the request host. When running on a device make sure the
# app reaches the backend host (see EXPO_PUBLIC_API_URL in the app).
